# KSMS configuration — copy to .env and adjust.

# HTTP listen port (APP_PORT is accepted as an alias)
PORT=8081

# JWT signing secret — REQUIRED in production. If unset, a random per-process
# key is generated and all sessions are invalidated on restart.
JWT_SECRET=change-me-to-a-long-random-string

# Set to "true" when serving over HTTPS so the auth cookie gets the Secure flag
COOKIE_SECURE=false

# PostgreSQL connection (used when DB is reachable; otherwise file/memory fallback)
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=admin123
DB_NAME=ksms

# Default administrator seeded on first run
DEFAULT_ADMIN_EMAIL=admin@ksms.io
DEFAULT_ADMIN_PASSWORD=admin123

# Optional: path to a Kubernetes API server audit log (JSON) to monitor for
# exec/attach/portforward activity. KSMS_AUDIT_CLUSTER optionally pins the
# cluster the alerts belong to (defaults to the first configured cluster).
# KSMS_AUDIT_LOG=/var/log/kubernetes/audit.log
# KSMS_AUDIT_CLUSTER=cluster-abc
